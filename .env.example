# Copy to .env and fill in. Never commit .env.

# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Postgres connection string. This default is the local database from docker-compose.yml;
# in production it is the Supabase session-pooler URI (project > Connect).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/gridcast

# Supabase project settings > API. The service-role key is for pipeline jobs only;
# it must never be used in web/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
